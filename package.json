{
	"name": "obsidian-transcript",
	"version": "0.1.0",
	"description": "Rich audio transcript editing with word-level alignment",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "bun run scripts/build-watch.ts",
		"build": "tsc -noEmit -skipLibCheck && bun run scripts/build-prod.ts",
		"test": "bun test",
		"harness:build": "bun build test-harness/test-entry.ts --outfile=test-harness/bundle.js --format=esm",
		"harness:serve": "python3 -m http.server 8765 -d test-harness",
		"harness": "bun run harness:build && bun run harness:serve"
	},
	"keywords": ["obsidian", "transcript", "audio", "alignment"],
	"author": "Andy Matuschak",
	"license": "MIT",
	"devDependencies": {
		"@types/bun": "latest",
		"@types/node": "^16.11.6",
		"tslib": "2.4.0",
		"typescript": "^5.8.3"
	},
	"dependencies": {
		"@codemirror/commands": "^6.10.1",
		"mdast-util-directive": "^3.1.0",
		"mdast-util-from-markdown": "^2.0.2",
		"mdast-util-to-markdown": "^2.1.2",
		"micromark": "^4.0.2",
		"micromark-extension-directive": "^4.0.0",
		"obsidian": "latest"
	}
}
